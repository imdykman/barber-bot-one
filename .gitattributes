# Автоматическая нормализация окончаний строк
* text=auto

# JavaScript файлы
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# SQL файлы
*.sql text eol=lf

# Конфигурационные файлы
.env.example text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Бинарные файлы (не трогать)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary